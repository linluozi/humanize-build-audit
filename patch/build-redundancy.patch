diff --git a/scripts/generate-translation-binaries.sh b/scripts/generate-translation-binaries.sh
index 5e54776..d961791 100644
--- a/scripts/generate-translation-binaries.sh
+++ b/scripts/generate-translation-binaries.sh
@@ -1,8 +1,44 @@
 set -e
 
+# Compile every .po catalog into a binary .mo catalog.
+#
+# The conversions are independent of each other, and most of the old
+# sequential loop's wall clock went to process start-up rather than to the
+# conversion itself, so they now run in bounded parallel batches.  The .mo
+# files produced are byte-identical to the sequential loop's output, the
+# locale names are still echoed in sorted order so CI logs stay diffable, and
+# a broken catalog still stops the run instead of being skipped.
+#
+# JOBS caps the batch width: a 2-core CI runner should not be asked to start
+# 36 compilers at once, and past 8 the wall clock stops improving.
+
+JOBS="${JOBS:-8}"
+batch=""
+running=0
+failed=0
+
+reap() {
+    for pid in $batch; do
+        wait "$pid" || failed=1
+    done
+    batch=""
+    running=0
+    if [ "$failed" -ne 0 ]; then
+        echo "translation compilation failed" >&2
+        exit 1
+    fi
+}
+
 for d in src/humanize/locale/*/; do
     locale="$(basename $d)"
     echo "$locale"
     # compile to binary .mo
-    msgfmt --check -o src/humanize/locale/$locale/LC_MESSAGES/humanize{.mo,.po}
+    msgfmt --check -o "src/humanize/locale/$locale/LC_MESSAGES/humanize.mo" \
+        "src/humanize/locale/$locale/LC_MESSAGES/humanize.po" &
+    batch="$batch $!"
+    running=$((running + 1))
+    if [ "$running" -ge "$JOBS" ]; then
+        reap
+    fi
 done
+reap
diff --git a/tox.ini b/tox.ini
index 9197a76..380e22e 100644
--- a/tox.ini
+++ b/tox.ini
@@ -15,10 +15,19 @@ extras =
 pass_env =
     FORCE_COLOR
 commands =
+    # --benchmark-disable still runs the 15 benchmark functions, it only skips
+    # the timing loop, so pass counts and coverage are unchanged.  The table
+    # pytest-benchmark prints here was never consumed by anything: benchmark.yml
+    # is what tracks those numbers, through CodSpeed.  Timing them again in
+    # every matrix cell cost ~3.7s out of a ~13s test step.  Pass
+    # --benchmark-enable to time them locally.
+    #
+    # The html report is dropped as well: nothing reads htmlcov/, and it costs
+    # more to write than the xml report that codecov actually uploads.
     {envpython} -m pytest \
+      --benchmark-disable \
       --cov humanize \
       --cov tests \
-      --cov-report html \
       --cov-report term \
       --cov-report xml \
       {posargs}
