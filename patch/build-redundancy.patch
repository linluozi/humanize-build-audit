diff --git a/.github/workflows/test.yml b/.github/workflows/test.yml
index 515f29f..fd02572 100644
--- a/.github/workflows/test.yml
+++ b/.github/workflows/test.yml
@@ -52,13 +52,35 @@ jobs:
         run: |
           brew install gettext
 
+      # Without msgfmt the compile step is a no-op, and the ~110 locale tests
+      # then *skip* instead of failing, so Windows used to report a green run
+      # that had silently skipped all of them.
+      - name: Install Windows dependencies
+        if: startsWith(matrix.os, 'windows')
+        run: |
+          choco install gettext --no-progress -y
+          refreshenv
+          msgfmt --version
+
       - name: Install uv
         uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
 
+      # `shell: bash` is required on Windows: the default pwsh shell does not
+      # execute a .sh file, it silently succeeds without running anything.
       - name: Generate translation binaries
+        shell: bash
         run: |
           scripts/generate-translation-binaries.sh
 
+      # A build with no compiled catalogs passes 744 tests and skips 112.
+      # Assert the catalogs exist so that regression can never look green again.
+      - name: Verify translation binaries
+        shell: bash
+        run: |
+          count=$(ls src/humanize/locale/*/LC_MESSAGES/*.mo | wc -l)
+          echo "compiled catalogs: $count"
+          test "$count" -ge 36
+
       - name: Tox tests
         run: |
           uvx --python ${{ matrix.python-version }} --with tox-uv tox -e py
